name = "world"
print("hello {name}, 1+1={1 + 1}")
print("nested {"inner {name}"} done")
print("brace \{literal\} and quote \" and tab\tend")
print("unicode \u{1F600}")
s = "  Hello, World  "
print(s.trim(), s.trim().upper(), s.trim().lower(), len(s), s.trim().len())
print("a,b,c".split(","), "a b  c".split(), "abc".split(""))
print("x-y".replace("-", "+"), "hello".contains("ell"), "hello".starts_with("he"), "hello".ends_with("lo"))
print("42".to_int() + 1, "2.5".to_float() * 2, int("  7 "), float("1e3"))
print("l1\nl2".lines(), "héllo"[1], "héllo"[-1], len("héllo"))
print(join(["a", "b"], "/"), ["x", 1, nil].join(","))
print(upper("abc"), trim("  x "), contains("abc", "b"), split("a:b", ":"))
print("abc".index_of("c"), "abc".index_of("z"), "hello".slice(1, 3), "hello".slice(-2))
print(str(1), str(nil), str([1, "a"]), str({k: [true]}), str(1.5), str(2.0))
empty = ""
print("[{empty}]", "{nil}", "{true}", "{[1, 2]}", "{{a: nil}}")
